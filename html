    // ==================== 音效合成器 ====================
    class SoundFX {
      constructor() {
        this.enabled = true;
        this.ctx = null;
      }
      ensureCtx() {
        if (!this.enabled) return null;
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === "suspended") {
          this.ctx.resume().catch(() => {});
        }
        return this.ctx;
      }
      playTone(freq, duration, type = "sine", delay = 0, gainVal = 0.12) {
        const ctx = this.ensureCtx();
        if (!ctx) return;
        const now = ctx.currentTime + delay;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, now);
        gain.gain.setValueAtTime(gainVal, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + duration);
      }
      ok(combo) {
        const boost = Math.min(combo, 10) * 28;
        this.playTone(520 + boost, 0.11, "triangle", 0, 0.13);
        this.playTone(780 + boost, 0.16, "sine", 0.07, 0.13);
      }
      convert() {
        this.playTone(440, 0.09, "sawtooth", 0, 0.08);
        this.playTone(660, 0.12, "triangle", 0.06, 0.12);
        this.playTone(880, 0.15, "sine", 0.12, 0.12);
      }
      bad() {
        this.playTone(210, 0.18, "sawtooth", 0, 0.12);
        this.playTone(155, 0.24, "square", 0.1, 0.1);
      }
    }
