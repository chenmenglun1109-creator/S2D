<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>台味夜市：語言海關｜3D 兩岸用語互動小遊戲</title>
  <style>
    :root {
      --bg: #141118;
      --panel: rgba(24, 20, 31, 0.86);
      --panel-border: rgba(255, 224, 178, 0.22);
      --ink: #fff8ee;
      --muted: #c9bfd2;
      --amber: #ff9f2e;
      --coral: #ff5733;
      --jade: #28c780;
      --jade-bg: rgba(40, 199, 128, 0.16);
      --crimson: #ff4d5a;
      --crimson-bg: rgba(255, 77, 90, 0.16);
      --gold: #ffd166;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--bg);
      color: var(--ink);
      font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
      touch-action: none;
    }

    #scene-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      z-index: 1;
    }

    .hud {
      position: fixed;
      inset: 0;
      z-index: 10;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 14px 16px 18px;
    }

    .hud-interactive {
      pointer-events: auto;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
      flex-wrap: wrap;
    }

    .brand {
      background: var(--panel);
      border: 1px solid var(--panel-border);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 10px 14px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }

    .brand h1 {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--gold);
      letter-spacing: 0.5px;
    }

    .brand p {
      font-size: 0.78rem;
      color: var(--muted);
      margin-top: 2px;
    }

    .stats-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }

    .stat-pill {
      background: var(--panel);
      border: 1px solid var(--panel-border);
      backdrop-filter: blur(10px);
      border-radius: 999px;
      padding: 7px 13px;
      font-size: 0.86rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 5px;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
    }

    .stat-pill.combo {
      border-color: rgba(255, 209, 102, 0.5);
      color: var(--gold);
    }

    .stat-pill.danger {
      border-color: rgba(255, 77, 90, 0.75);
      color: var(--crimson);
      background: var(--crimson-bg);
    }

    .icon-btn {
      background: var(--panel);
      border: 1px solid var(--panel-border);
      backdrop-filter: blur(10px);
      color: var(--ink);
      border-radius: 999px;
      padding: 7px 13px;
      font-size: 0.84rem;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.12s ease, border-color 0.15s ease;
    }

    .icon-btn:hover {
      border-color: var(--amber);
      transform: translateY(-1px);
    }

    .customer-banner {
      align-self: center;
      max-width: 680px;
      width: 100%;
      background: var(--panel);
      border: 1px solid var(--panel-border);
      backdrop-filter: blur(12px);
      border-radius: 18px;
      padding: 12px 16px;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.42);
      transition: transform 0.18s ease, border-color 0.2s ease;
    }

    .customer-banner.flash-ok {
      border-color: var(--jade);
      box-shadow: 0 0 24px rgba(40, 199, 128, 0.28);
    }

    .customer-banner.flash-bad {
      border-color: var(--crimson);
      box-shadow: 0 0 24px rgba(255, 77, 90, 0.28);
    }

    .customer-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      font-size: 0.78rem;
      color: var(--muted);
      margin-bottom: 5px;
    }

    .tag-chip {
      background: rgba(255, 159, 46, 0.18);
      color: var(--amber);
      border: 1px solid rgba(255, 159, 46, 0.4);
      padding: 2px 8px;
      border-radius: 999px;
      font-weight: 700;
    }

    .customer-quote {
      font-size: 1.02rem;
      font-weight: 700;
      line-height: 1.45;
      color: var(--ink);
    }

    .feedback-toast {
      margin-top: 6px;
      font-size: 0.84rem;
      line-height: 1.4;
      min-height: 1.2em;
      color: var(--gold);
    }

    .feedback-toast.ok {
      color: var(--jade);
    }

    .feedback-toast.bad {
      color: var(--crimson);
    }

    .bottom-controls {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .lane-labels {
      width: 100%;
      max-width: 640px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .lane-btn {
      pointer-events: auto;
      border-radius: 16px;
      padding: 13px 14px;
      font-size: 0.96rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      backdrop-filter: blur(10px);
      transition: transform 0.1s ease, filter 0.15s ease;
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
    }

    .lane-btn:active {
      transform: scale(0.97);
    }

    .lane-btn.pass {
      background: var(--jade-bg);
      border: 1.5px solid rgba(40, 199, 128, 0.65);
      color: #a8f5d0;
    }

    .lane-btn.convert {
      background: rgba(255, 159, 46, 0.18);
      border: 1.5px solid rgba(255, 159, 46, 0.7);
      color: #ffd599;
    }

    .lane-sub {
      font-size: 0.74rem;
      font-weight: 500;
      opacity: 0.88;
    }

    .control-hint {
      font-size: 0.78rem;
      color: var(--muted);
      background: rgba(15, 13, 20, 0.72);
      padding: 5px 12px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      text-align: center;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 30;
      background: rgba(9, 8, 13, 0.78);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal-card {
      width: 100%;
      max-width: 620px;
      max-height: 88vh;
      overflow-y: auto;
      background: #1c1724;
      border: 1.5px solid var(--panel-border);
      border-radius: 22px;
      padding: 24px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);
    }

    .modal-card h2 {
      font-size: 1.35rem;
      color: var(--gold);
      margin-bottom: 8px;
    }

    .modal-card p.lead {
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.6;
      margin-bottom: 16px;
    }

    .ending-badge {
      display: inline-block;
      background: rgba(255, 87, 51, 0.22);
      border: 1px solid var(--coral);
      color: #ffb199;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .ending-title {
      font-size: 1.55rem;
      font-weight: 800;
      color: var(--ink);
      margin-bottom: 8px;
    }

    .ending-dish {
      background: rgba(255, 209, 102, 0.12);
      border-left: 4px solid var(--gold);
      padding: 12px 14px;
      border-radius: 10px;
      margin-bottom: 14px;
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 16px;
    }

    .summary-box {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 12px;
      padding: 10px;
      text-align: center;
    }

    .summary-box .num {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--gold);
    }

    .summary-box .lbl {
      font-size: 0.76rem;
      color: var(--muted);
      margin-top: 2px;
    }

    .primary-btn {
      width: 100%;
      padding: 13px 18px;
      border-radius: 14px;
      border: none;
      background: linear-gradient(135deg, var(--amber), var(--coral));
      color: #151018;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      transition: transform 0.12s ease, filter 0.15s ease;
    }

    .primary-btn:hover {
      filter: brightness(1.06);
      transform: translateY(-1px);
    }

    .secondary-btn {
      padding: 10px 14px;
      border-radius: 12px;
      border: 1px solid var(--panel-border);
      background: rgba(255, 255, 255, 0.06);
      color: var(--ink);
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
    }

    .dex-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      gap: 8px;
      margin: 14px 0 18px;
      max-height: 300px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .dex-item {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 8px 10px;
      font-size: 0.8rem;
    }

    .dex-item.unlocked {
      border-color: rgba(40, 199, 128, 0.45);
      background: rgba(40, 199, 128, 0.08);
    }

    .dex-item .ename {
      font-weight: 700;
      color: var(--gold);
    }

    .dex-item .edesc {
      color: var(--muted);
      font-size: 0.74rem;
      margin-top: 2px;
      line-height: 1.35;
    }

    @media (max-width: 560px) {
      .brand h1 { font-size: 1rem; }
      .customer-quote { font-size: 0.94rem; }
      .summary-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <canvas id="scene-canvas"></canvas>

  <div class="hud">
    <div class="top-bar">
      <div class="brand hud-interactive">
        <h1>台味夜市：語言海關</h1>
        <p>3D 詞彙輸送帶｜滑動木箱放行或改裝</p>
      </div>

      <div class="stats-row hud-interactive">
        <div class="stat-pill" id="scorePill">得分：0</div>
        <div class="stat-pill combo" id="comboPill">🔥 0 連擊</div>
        <div class="stat-pill" id="livesPill">❤️ 5</div>
        <div class="stat-pill" id="roundPill">1 / 12</div>
        <button type="button" class="icon-btn" id="openDexBtn">📖 結局圖鑑 (0/12)</button>
        <button type="button" class="icon-btn" id="soundBtn">🔊 音效開</button>
      </div>
    </div>

    <div class="customer-banner hud-interactive" id="customerBanner">
      <div class="customer-meta">
        <span id="customerRole">夜市客人 #1・準備點餐</span>
        <span class="tag-chip" id="wordTypeTag">語感鑑定中</span>
      </div>
      <div class="customer-quote" id="customerQuote">「老闆，幫我看看這箱詞彙算不算道地台灣話！」</div>
      <div class="feedback-toast" id="feedbackToast">向左滑動「放行台灣詞」；向右滑動「攔截改裝成台味」！</div>
    </div>

    <div class="bottom-controls">
      <div class="lane-labels">
        <button type="button" class="lane-btn pass" id="btnPassLeft">
          <span>⬅️ 向左：放行台灣慣用語</span>
          <span class="lane-sub">直接送上桌（含語感陷阱詞）</span>
        </button>
        <button type="button" class="lane-btn convert" id="btnConvertRight">
          <span>➡️ 向右：改裝成台味</span>
          <span class="lane-sub">送進改裝機換成台灣用語</span>
        </button>
      </div>
      <div class="control-hint">
        操作方式：直接用手指/滑鼠左右撥動 3D 木箱、按鍵盤「← / →」，或點選下方按鈕
      </div>
    </div>
  </div>

  <!-- 開始說明 Modal -->
  <div class="modal-backdrop open" id="startModal">
    <div class="modal-card">
      <h2>🏮 台味夜市：語言海關</h2>
      <p class="lead">
        你現在是台灣夜市攤位的「語言海關主廚」！詞彙木箱會沿著中央輸送帶往前推進，速度會隨連擊與題數加快：
      </p>
      <div class="ending-dish">
        <div><strong>⬅️ 向左放行：</strong>台灣本來就會用的慣用語，或是容易被誤認的「語感陷阱詞」。</div>
        <div style="margin-top:6px;"><strong>➡️ 向右改裝：</strong>中國大陸用語，送進右側改裝機後會立刻換成道地台灣用語並彈進左側料理鍋！</div>
      </div>
      <p class="lead" style="margin-bottom:18px;">
        一局共 <strong>12 箱</strong>，依準確率、連擊數、陷阱題表現與剩餘生命，解鎖 <strong>12 種夜市結局</strong>！
      </p>
      <button type="button" class="primary-btn" id="startGameBtn">開張營業！開始挑戰</button>
    </div>
  </div>

  <!-- 結算多結局 Modal -->
  <div class="modal-backdrop" id="resultModal">
    <div class="modal-card">
      <div class="ending-badge" id="endingCode">結局 #01</div>
      <div class="ending-title" id="endingTitle">道地台灣味大師</div>
      <div class="ending-dish" id="endingDish">今日端出：金黃酥脆蚵仔煎佐特製甜辣醬</div>

      <div class="summary-grid">
        <div class="summary-box">
          <div class="num" id="resScore">0</div>
          <div class="lbl">最終得分</div>
        </div>
        <div class="summary-box">
          <div class="num" id="resAccuracy">0%</div>
          <div class="lbl">分類準確率</div>
        </div>
        <div class="summary-box">
          <div class="num" id="resMaxCombo">0</div>
          <div class="lbl">最高連擊</div>
        </div>
      </div>

      <p class="lead" id="endingComment" style="margin-bottom:16px;"></p>

      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <button type="button" class="primary-btn" style="flex:1; min-width:180px;" id="playAgainBtn">再玩一局（拼新結局）</button>
        <button type="button" class="secondary-btn" id="openDexFromResultBtn">查看結局圖鑑</button>
      </div>
    </div>
  </div>

  <!-- 12 種多結局圖鑑 Modal -->
  <div class="modal-backdrop" id="dexModal">
    <div class="modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
        <h2>📖 夜市多結局圖鑑</h2>
        <button type="button" class="secondary-btn" id="closeDexBtn">關閉</button>
      </div>
      <p class="lead" id="dexProgressText">已解鎖 0 / 12 種結局</p>
      <div class="dex-list" id="dexList"></div>
    </div>
  </div>

  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.187.0/build/three.module.js"
      }
    }
  </script>

  <script type="module">
    import * as THREE from 'three';

    // ==================== 題庫：包含台灣慣用語、大陸用語與模糊地帶陷阱題 ====================
    const WORD_BANK = [
      // 大陸用語 -> 需向右改裝成台灣慣用語
      { word: "視頻", isMainland: true, isTrap: false, twWord: "影片", category: "科技網路", customerType: "大學生", quote: "「這支短視頻在網路上超夯，幫我改成台味！」", tip: "台灣普遍稱「影片」，大陸多稱「視頻」。" },
      { word: "鼠標", isMainland: true, isTrap: false, twWord: "滑鼠", category: "科技網路", customerType: "工程師", quote: "「我的無線鼠標沒電了，快幫我換掉！」", tip: "台灣依外型與滑動操作稱「滑鼠」，大陸稱「鼠標」。" },
      { word: "屏幕", isMainland: true, isTrap: false, twWord: "螢幕", category: "科技網路", customerType: "高中生", quote: "「手機屏幕貼膜歪掉了，幫我改裝一下！」", tip: "台灣電子顯示器多稱「螢幕」。" },
      { word: "土豆", isMainland: true, isTrap: false, twWord: "馬鈴薯", category: "夜市食材", customerType: "吃貨觀光客", quote: "「炸土豆條要撒梅粉，先幫我把詞改對！」", tip: "台灣說的「土豆」通常指花生，薯條原料是「馬鈴薯」。" },
      { word: "西紅柿", isMainland: true, isTrap: false, twWord: "番茄", category: "夜市食材", customerType: "家庭主婦", quote: "「番茄炒蛋寫成西紅柿了，快攔截改裝！」", tip: "台灣日常多稱「番茄」。" },
      { word: "打車", isMainland: true, isTrap: false, twWord: "搭計程車", category: "日常生活", customerType: "夜歸上班族", quote: "「夜市太晚了，我們直接打車回家吧！」", tip: "台灣習慣說「搭計程車」或「叫車」。" },
      { word: "充電寶", isMainland: true, isTrap: false, twWord: "行動電源", category: "科技網路", customerType: "背包客", quote: "「出門逛夜市一定要帶充電寶，幫我轉台味！」", tip: "台灣普遍稱為「行動電源」。" },
      { word: "U盤", isMainland: true, isTrap: false, twWord: "隨身碟", category: "科技網路", customerType: "研究生", quote: "「簡報檔存在 U盤 裡了，快幫我改名！」", tip: "台灣多稱「隨身碟」。" },
      { word: "班主任", isMainland: true, isTrap: false, twWord: "班導", category: "校園生活", customerType: "高二同學", quote: "「明天早自習班主任要抽查，幫我翻成台式！」", tip: "台灣國高中習慣稱「班導」或「導師」。" },
      { word: "創可貼", isMainland: true, isTrap: false, twWord: "OK繃", category: "日常生活", customerType: "熱心路人", quote: "「切食材不小心劃到手指，拿張創可貼！」", tip: "台灣習慣稱「OK繃」。" },

      // 台灣道地慣用語 -> 需向左放行
      { word: "CP值", isMainland: false, isTrap: false, twWord: "CP值", category: "台灣慣用", customerType: "美食部落客", quote: "「這攤雞排份量爆多，CP值真的很高！」", tip: "「CP值」是台灣非常道地的流行用語。" },
      { word: "隨身碟", isMainland: false, isTrap: false, twWord: "隨身碟", category: "台灣慣用", customerType: "社團幹部", quote: "「作業已經存進隨身碟了，直接放行吧！」", tip: "「隨身碟」就是標準台灣用語，別亂改！" },
      { word: "冷氣", isMainland: false, isTrap: false, twWord: "冷氣", category: "台灣慣用", customerType: "怕熱阿伯", quote: "「室內冷氣開 26 度最舒服，直接通關！」", tip: "台灣口語習慣說「冷氣」。" },
      { word: "捷運", isMainland: false, isTrap: false, twWord: "捷運", category: "台灣慣用", customerType: "通勤族", quote: "「搭捷運到淡水線最方便，直接放行！」", tip: "台灣大眾運輸系統稱「捷運」。" },

