    let queue = [];
    let flyingAnim = null;
    let dragState = { active: false, startX: 0, baseX: 0 };

    function shuffle(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function updateHud() {
      scorePill.textContent = `得分：${state.score}`;
      comboPill.textContent = `🔥 ${state.combo} 連擊`;
      livesPill.textContent = `❤️ ${Math.max(0, state.lives)}`;
      livesPill.classList.toggle("danger", state.lives <= 2);
      roundPill.textContent = `${Math.min(state.round, TOTAL_ROUNDS)} / ${TOTAL_ROUNDS}`;
    }

    function updateDexButton() {
      const count = loadUnlockedEndings().length;
      openDexBtn.textContent = `📖 結局圖鑑 (${count}/${ENDINGS.length})`;
    }

    function setBannerFlash(kind) {
      customerBanner.classList.remove("flash-ok", "flash-bad");
      if (kind) {
        customerBanner.classList.add(kind === "ok" ? "flash-ok" : "flash-bad");
        setTimeout(() => customerBanner.classList.remove("flash-ok", "flash-bad"), 380);
      }
    }

    function spawnNextCrate() {
      if (state.lives <= 0 || state.round >= TOTAL_ROUNDS) {
        finishGame();
        return;
      }

      if (queue.length === 0) {
        queue = shuffle(WORD_BANK);
      }
      const item = queue.pop();
      state.currentItem = item;
      state.round += 1;
      state.beltSpeed = 2.15 + (state.round - 1) * 0.14 + Math.min(state.combo, 8) * 0.08;

      flyingAnim = null;
      topLabelMat.map = createBoxLabelTexture(item.word, "#f7e6c4", "#b56528", "#231914");
      topLabelMat.needsUpdate = true;

      crateMesh.position.set(0, 0.52, -4.6);
      crateMesh.rotation.set(0, 0, 0);
      crateMesh.scale.set(1, 1, 1);

      summonNewCustomer();

      customerRole.textContent = `客人 #${state.round}（${item.customerType}）・${item.category}`;
      wordTypeTag.textContent = item.isTrap ? "語感陷阱？" : "即時鑑定";
      customerQuote.textContent = item.quote;
      updateHud();
    }

    function resolveDecision(choice) {
      if (state.phase !== "PLAYING" || !state.currentItem || flyingAnim) return;

      const item = state.currentItem;
      const isCorrect =
        (choice === "CONVERT" && item.isMainland) ||
        (choice === "PASS" && !item.isMainland);

      if (choice === "CONVERT") state.convertCount += 1;
      else state.passCount += 1;

      if (isCorrect) {
        state.combo += 1;
        state.maxCombo = Math.max(state.maxCombo, state.combo);
        state.correctCount += 1;
        if (item.isTrap) state.trapHits += 1;

        const gained = 100 + Math.max(0, state.combo - 1) * 25 + (item.isTrap ? 30 : 0);
        state.score += gained;
        triggerCustomerReaction("HAPPY");

        if (item.isMainland) {
          sfx.convert();
          topLabelMat.map = createBoxLabelTexture(item.twWord, "#d8f8e8", "#1f8a5b", "#0e472d");
          topLabelMat.needsUpdate = true;
          feedbackToast.className = "feedback-toast ok";
          feedbackToast.textContent = `✅ 改裝成功！「${item.word}」→「${item.twWord}」（+${gained} 分）`;
          spawnBurst(new THREE.Vector3(3.8, 1.0, 1.2), 0xff9f2e, 14);
        } else {
          sfx.ok(state.combo);
          feedbackToast.className = "feedback-toast ok";
          feedbackToast.textContent = `✅ 放行正確！「${item.word}」可安心上桌！（+${gained} 分）｜${item.tip}`;
          spawnBurst(new THREE.Vector3(-3.8, 1.0, 1.2), 0x28c780, 14);
        }
        setBannerFlash("ok");
      } else {
        sfx.bad();
        state.combo = 0;
        state.lives -= 1;
        state.score = Math.max(0, state.score - 30);
        triggerCustomerReaction("CONFUSED");
        feedbackToast.className = "feedback-toast bad";
        feedbackToast.textContent = `❌ 判斷失誤！「${item.word}」${item.isMainland ? `應向右改裝成「${item.twWord}」` : `其實是台灣可放行詞彙` }。${item.tip}`;
        setBannerFlash("bad");
        spawnBurst(crateMesh.position.clone().add(new THREE.Vector3(0, 0.8, 0)), 0xff4d5a, 14);
      }

      updateHud();

      const targetX = choice === "PASS" ? -4.2 : 4.2;
      flyingAnim = {
        t: 0,
        startPos: crateMesh.position.clone(),
        targetPos: new THREE.Vector3(targetX, 0.8, 1.2),
        onComplete: () => {
          if (state.lives <= 0 || state.round >= TOTAL_ROUNDS) {
            finishGame();
          } else {
            spawnNextCrate();
          }
        }
      };
    }

    function pickEnding() {
      const accuracy = state.round > 0 ? state.correctCount / state.round : 0;
      if (state.lives <= 0) return ENDINGS[11];
      if (accuracy >= 0.9 && state.trapHits >= 1) return ENDINGS[0];
      if (state.convertCount >= 5 && accuracy >= 0.75) return ENDINGS[1];
      if (state.trapHits >= 2 && accuracy >= 0.65) return ENDINGS[2];
      if (state.maxCombo >= 5) return ENDINGS[3];
      if (accuracy >= 0.45 && accuracy < 0.7) return ENDINGS[4];
      if (state.passCount >= state.round - 1) return ENDINGS[9];
      if (state.convertCount >= state.round - 1 && accuracy < 0.5) return ENDINGS[8];
      if (state.lives === 1) return ENDINGS[7];
      if (accuracy < 0.35) return ENDINGS[6];
      if (state.score < 450) return ENDINGS[10];
      return ENDINGS[5];
    }

    function finishGame() {
      state.phase = "ENDED";
      const ending = pickEnding();
      saveUnlockedEnding(ending.code);

      const accPct = state.round > 0 ? Math.round((state.correctCount / state.round) * 100) : 0;
      document.getElementById("endingCode").textContent = ending.code;
      document.getElementById("endingTitle").textContent = ending.title;
      document.getElementById("endingDish").textContent = `夜市端出料理：${ending.dish}`;
      document.getElementById("resScore").textContent = `${state.score}`;
      document.getElementById("resAccuracy").textContent = `${accPct}%`;
      document.getElementById("resMaxCombo").textContent = `${state.maxCombo}`;
      document.getElementById("endingComment").textContent = ending.comment;

      resultModal.classList.add("open");
    }

    function startNewGame() {
      state.phase = "PLAYING";
      state.round = 0;
      state.score = 0;
      state.combo = 0;
      state.maxCombo = 0;
      state.lives = 5;
      state.correctCount = 0;
      state.trapHits = 0;
      state.convertCount = 0;
      state.passCount = 0;
      queue = shuffle(WORD_BANK);

      startModal.classList.remove("open");
      resultModal.classList.remove("open");
      dexModal.classList.remove("open");
      feedbackToast.className = "feedback-toast";
      feedbackToast.textContent = "向左滑動「放行台灣詞」；向右滑動「攔截改裝成台味」！";

      spawnNextCrate();
    }

    // ==================== 滑鼠 / 手指 / 鍵盤操作 ====================
    const raycaster = new THREE.Raycaster();
    const pointerNDC = new THREE.Vector2();

    function updateNDC(e) {
      const rect = canvas.getBoundingClientRect();
      pointerNDC.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      pointerNDC.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    }

    canvas.addEventListener("pointerdown", (e) => {
      if (state.phase !== "PLAYING" || flyingAnim) return;
      updateNDC(e);
      raycaster.setFromCamera(pointerNDC, camera);
      const hit = raycaster.intersectObject(crateMesh, false);
      if (hit.length > 0 || Math.abs(pointerNDC.y) < 0.55) {
        dragState = { active: true, startX: e.clientX, baseX: crateMesh.position.x };
      }
    });

    window.addEventListener("pointermove", (e) => {
      if (!dragState.active || state.phase !== "PLAYING" || flyingAnim) return;
      const dx = (e.clientX - dragState.startX) * 0.018;
      crateMesh.position.x = THREE.MathUtils.clamp(dragState.baseX + dx, -3.6, 3.6);
      crateMesh.rotation.z = -crateMesh.position.x * 0.14;
    });

    window.addEventListener("pointerup", () => {
      if (!dragState.active) return;
      dragState.active = false;
      if (state.phase !== "PLAYING" || flyingAnim) return;

      if (crateMesh.position.x <= -1.15) {
        resolveDecision("PASS");
      } else if (crateMesh.position.x >= 1.15) {
        resolveDecision("CONVERT");
      } else {
        crateMesh.position.x = 0;
        crateMesh.rotation.z = 0;
      }
    });

    window.addEventListener("keydown", (e) => {
      if (state.phase !== "PLAYING") return;
      if (e.key === "ArrowLeft" || e.key === "a" || e.key === "A") {
        resolveDecision("PASS");
      } else if (e.key === "ArrowRight" || e.key === "d" || e.key === "D") {
        resolveDecision("CONVERT");
      }
    });

    document.getElementById("btnPassLeft").addEventListener("click", () => resolveDecision("PASS"));
    document.getElementById("btnConvertRight").addEventListener("click", () => resolveDecision("CONVERT"));
    document.getElementById("startGameBtn").addEventListener("click", startNewGame);
    document.getElementById("playAgainBtn").addEventListener("click", startNewGame);

    soundBtn.addEventListener("click", () => {
      sfx.enabled = !sfx.enabled;
      soundBtn.textContent = sfx.enabled ? "🔊 音效開" : "🔇 音效關";
    });

    function renderDexModal() {
      const unlocked = new Set(loadUnlockedEndings());
      document.getElementById("dexProgressText").textContent = `已解鎖 ${unlocked.size} / ${ENDINGS.length} 種結局`;
      const listEl = document.getElementById("dexList");
      listEl.innerHTML = "";
      ENDINGS.forEach((ep) => {
        const isUn = unlocked.has(ep.code);
        const div = document.createElement("div");
        div.className = `dex-item ${isUn ? "unlocked" : ""}`;
        div.innerHTML = `
          <div class="ename">${ep.code} ${isUn ? "✅" : "🔒"}</div>
          <div class="edesc">${isUn ? `${ep.title}：${ep.dish}` : "尚未解鎖，快去夜市挑戰看看！"}</div>
        `;
        listEl.appendChild(div);
      });
    }

    openDexBtn.addEventListener("click", () => {
      renderDexModal();
      dexModal.classList.add("open");
    });

    document.getElementById("openDexFromResultBtn").addEventListener("click", () => {
      resultModal.classList.remove("open");
      renderDexModal();
      dexModal.classList.add("open");
    });

    document.getElementById("closeDexBtn").addEventListener("click", () => {
      dexModal.classList.remove("open");
    });

    // ==================== 視窗縮放與主動畫迴圈 ====================
    window.addEventListener("resize", () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    const clock = new THREE.Clock();
    function animate() {
      requestAnimationFrame(animate);
      const dt = Math.min(clock.getDelta(), 0.05);
      const elapsed = clock.getElapsedTime();

      // 輸送帶條紋滾動
      stripes.forEach((s) => {
        s.position.z += state.beltSpeed * dt;
        if (s.position.z > 4.1) s.position.z -= 9.5;
      });

      // 燈籠微晃與裝置呼吸光
      lanterns.forEach((l, idx) => {
        l.rotation.z = Math.sin(elapsed * 1.8 + idx) * 0.09;
      });
      potRim.rotation.z += dt * 1.4;
      machineBeacon.material.emissiveIntensity = 0.7 + Math.sin(elapsed * 4) * 0.25;
      signGlowLight.intensity = 2.6 + Math.sin(elapsed * 3) * 0.35;

      // 3D 客人進場與表情動作
      customerGroup.position.x = THREE.MathUtils.lerp(customerGroup.position.x, customerAnim.targetX, dt * 6);
      const walkSwing = Math.abs(customerGroup.position.x - customerAnim.targetX) > 0.06
        ? Math.sin(elapsed * 16) * 0.45
        : 0;
      leftLeg.rotation.x = walkSwing;
      rightLeg.rotation.x = -walkSwing;

      if (customerAnim.reactionTimer > 0) {
        customerAnim.reactionTimer -= dt;
        if (customerAnim.reaction === "HAPPY") {
          customerGroup.position.y = -0.8 + Math.abs(Math.sin(elapsed * 14)) * 0.32;
          headGroup.rotation.x = Math.sin(elapsed * 18) * 0.22;
          leftArm.rotation.x = -2.2;
          rightArm.rotation.x = -2.2;
        } else if (customerAnim.reaction === "CONFUSED") {
          customerGroup.position.y = -0.8;
          headGroup.rotation.y = Math.sin(elapsed * 22) * 0.35;
          leftArm.rotation.x = -0.35;
          rightArm.rotation.x = -0.35;
        }
      } else {
        customerGroup.position.y = -0.8 + Math.sin(elapsed * 3.2) * 0.03;
        headGroup.rotation.x = THREE.MathUtils.lerp(headGroup.rotation.x, 0, dt * 8);
        headGroup.rotation.y = THREE.MathUtils.lerp(headGroup.rotation.y, 0, dt * 8);
        leftArm.rotation.x = THREE.MathUtils.lerp(leftArm.rotation.x, -0.35, dt * 8);
        rightArm.rotation.x = THREE.MathUtils.lerp(rightArm.rotation.x, -0.35, dt * 8);
      }

      // 遊戲中木箱推進或飛出動畫
      if (state.phase === "PLAYING") {
        if (flyingAnim) {
          flyingAnim.t += dt * 3.4;
          const p = Math.min(flyingAnim.t, 1);
          const ease = 1 - Math.pow(1 - p, 3);
          crateMesh.position.lerpVectors(flyingAnim.startPos, flyingAnim.targetPos, ease);
          crateMesh.position.y += Math.sin(p * Math.PI) * 1.25;
          crateMesh.rotation.y += dt * 9;
          crateMesh.scale.setScalar(1 - p * 0.25);

          if (p >= 1) {
            const done = flyingAnim.onComplete;
            flyingAnim = null;
            done();
          }
        } else if (!dragState.active) {
          crateMesh.position.z += state.beltSpeed * dt;
          crateMesh.position.x = THREE.MathUtils.lerp(crateMesh.position.x, 0, dt * 8);
          crateMesh.rotation.z = THREE.MathUtils.lerp(crateMesh.rotation.z, 0, dt * 8);

          if (crateMesh.position.z >= 1.6) {
            sfx.bad();
            state.combo = 0;
            state.lives -= 1;
            state.score = Math.max(0, state.score - 30);
            triggerCustomerReaction("CONFUSED");
            feedbackToast.className = "feedback-toast bad";
            feedbackToast.textContent = `⏰ 慢了一步！「${state.currentItem.word}」滑出輸送帶啦！`;
            setBannerFlash("bad");
            updateHud();
            spawnNextCrate();
          }
        }
      } else {
        crateMesh.position.set(0, 0.52 + Math.sin(elapsed * 2.2) * 0.06, -1.2);
        crateMesh.rotation.y = Math.sin(elapsed * 1.1) * 0.25;
        crateMesh.rotation.z = 0;
        crateMesh.scale.setScalar(1);
      }

      // 更新粒子
      for (let i = particles.length - 1; i >= 0; i--) {
        const pt = particles[i];
        pt.life -= dt;
        pt.vel.y -= 9.8 * dt;
        pt.mesh.position.addScaledVector(pt.vel, dt);
        pt.mesh.rotation.x += dt * 6;
        pt.mesh.rotation.y += dt * 6;
        pt.mesh.scale.setScalar(Math.max(0.01, pt.life));
        if (pt.life <= 0) {
          scene.remove(pt.mesh);
          particles.splice(i, 1);
        }
      }

      renderer.render(scene, camera);
    }

    updateHud();
    updateDexButton();
    animate();
  </script>
</body>
